{
  "manifest_version": 3,
  "name": "AI Remover",
  "version": "1.0",
  "icons": {
    "48": "icons/icon48.png"
  },
  "description": "Automatically redirects to web results without AI.",
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.fr/search*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}